@PACKAGE_INIT@

if(NOT Mom6lib_FIND_QUIETLY)
  message(STATUS "Found Mom6lib: ${PACKAGE_PREFIX_DIR}")
endif()

include(CMakeFindDependencyMacro)

# Request components
set(_required_components ${Mom6lib_FIND_COMPONENTS})

find_dependency(fms COMPONENTS R8 REQUIRED)
find_dependency(GFDLGTracers REQUIRED)
find_dependency(NetCDF REQUIRED Fortran)

if(@OPENMP@)
  find_package(OpenMP REQUIRED)
endif()

# Run the normal Targets.cmake
list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})
include("${CMAKE_CURRENT_LIST_DIR}/Mom6libTargets.cmake")
list(REMOVE_ITEM CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

# Check the requested components are valid
check_required_components(_required_components)
